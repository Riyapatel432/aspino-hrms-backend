generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  role      String    @default("USER") // ADMIN, HR, EMPLOYEE
  createdAt DateTime  @default(now())
  employee  Employee?
}

model Employee {
  id               String               @id @default(uuid())
  employeeId       String               @unique // e.g. ASP-2026-0001
  userId           String?              @unique
  user             User?                @relation(fields: [userId], references: [id])
  firstName        String
  lastName         String
  email            String               @unique
  department       String
  designation      String
  managerId        String?
  dateOfJoining    DateTime
  probationEnd     DateTime?
  probationStatus  String               @default("UNDER_REVIEW") // UNDER_REVIEW, CONFIRMED, EXTENDED
  status           String               @default("ACTIVE") // ONBOARDING, ACTIVE, EXITING, RELIEVED
  
  // QR Code & Public Profile Details
  phone            String?
  location         String?
  qrToken          String               @unique @default(uuid())

  // Bank & Statutory Details
  bankId           Int?
  bank             Bank?                @relation(fields: [bankId], references: [id])
  bankName         String?
  accountNumber    String?
  ifscCode         String?
  panNumber        String?

  createdAt        DateTime             @default(now())
  documents        OnboardingDocument[]
  induction        InductionSchedule?
  systemAccess     SystemAccess?
  roster           ShiftRoster[]
  attendance       Attendance[]
  leaveBalances    LeaveBalance[]
  leaveApplications LeaveApplication[]
  leaveLedger      LeaveLedger[]
  goals            EmployeeGoal[]
  appraisalReviews AppraisalReview[]
  trainings        TrainingRecord[]
  exitProcess      ExitProcess?
  salaryStructures  SalaryStructure[]
  rentReceipts     HraRentReceipt[]
  taxDeclarations  TaxDeclaration[]
  loans            EmployeeLoan[]
  payslips         Payslip[]
}

model Department {
  id           String           @id @default(uuid())
  name         String           @unique
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  requisitions JobRequisition[]
}

model TrainingType {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model JobRequisition {
  id            String      @id @default(uuid())
  title         String
  departmentId  String
  department    Department  @relation(fields: [departmentId], references: [id])
  headcount     Int
  justification String
  status        String      @default("PENDING") // PENDING, APPROVED, REJECTED, FULFILLED
  raisedBy      String
  createdAt     DateTime    @default(now())
  candidates    Candidate[]
}

model Candidate {
  id              String              @id @default(uuid())
  name            String
  email           String              @unique
  phone           String?
  resumeUrl       String?
  source          String              // Referral, Portal, Agency, LinkedIn, Walk-in, Website
  status          String              @default("SOURCED") // SOURCED, INTERVIEWING, SELECTED, REJECTED, RE_INTERVIEW_ELIGIBLE, OFFERED, ACCEPTED
  isReInterview   Boolean             @default(false)
  rejectionCount  Int                 @default(0)
  rejectedAt      DateTime?
  coolOffDaysLeft Int?                @default(0)
  requisitionId   String
  requisition     JobRequisition      @relation(fields: [requisitionId], references: [id])
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @default(now()) @updatedAt
  schedules       InterviewSchedule[]
  offer           OfferLetter?
}

model InterviewSchedule {
  id            String              @id @default(uuid())
  candidateId   String
  candidate     Candidate           @relation(fields: [candidateId], references: [id])
  roundName     String              // e.g. Technical, HR, Manager
  scheduledAt   DateTime
  panelists     String[]              // Array or comma-separated panelist IDs
  status        String              @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED
  isReschedule  Boolean             @default(false)
  attemptNumber Int                 @default(1)
  feedbacks     InterviewFeedback[]
}

model InterviewFeedback {
  id             String            @id @default(uuid())
  scheduleId     String
  schedule       InterviewSchedule @relation(fields: [scheduleId], references: [id])
  panelistName   String
  rating         Int
  comments       String
  recommendation String            // SELECT, REJECT, HOLD
  createdAt      DateTime          @default(now())
}

model OfferLetter {
  id          String    @id @default(uuid())
  candidateId String    @unique
  candidate   Candidate @relation(fields: [candidateId], references: [id])
  role        String
  salary      Float
  joiningDate DateTime
  status      String    @default("GENERATED") // GENERATED, SENT, ACCEPTED, DECLINED
  createdAt   DateTime  @default(now())
}

model OnboardingDocument {
  id           String   @id @default(uuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id])
  documentType String   // Aadhaar, PAN, Passport, Address Proof, Education Certificates, Previous Employment, Bank Details, Photo
  status       String   @default("PENDING") // PENDING, SUBMITTED, VERIFIED, REJECTED
  fileUrl      String?
  verifiedAt   DateTime?
}

model InductionSchedule {
  id          String   @id @default(uuid())
  employeeId  String   @unique
  employee    Employee @relation(fields: [employeeId], references: [id])
  scheduledAt DateTime
  trainer     String
  status      String   @default("SCHEDULED") // SCHEDULED, COMPLETED
}

model SystemAccess {
  id             String   @id @default(uuid())
  employeeId     String   @unique
  employee       Employee @relation(fields: [employeeId], references: [id])
  erpLogin       Boolean  @default(false)
  email          Boolean  @default(false)
  attendanceApp  Boolean  @default(false)
  vpn            Boolean  @default(false)
}

model Shift {
  id        String        @id @default(uuid())
  name      String        // Morning, Evening, Night, Flexible
  startTime String        // HH:MM
  endTime   String
  rosters   ShiftRoster[]
}

model ShiftRoster {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  shiftId    String
  shift      Shift    @relation(fields: [shiftId], references: [id])
  date       DateTime
}

model Attendance {
  id                 String    @id @default(uuid())
  employeeId         String
  employee           Employee  @relation(fields: [employeeId], references: [id])
  date               DateTime
  checkIn            DateTime?
  checkOut           DateTime?
  status             String    @default("PRESENT") // PRESENT, ABSENT, LATE, HALFDAY
  shiftId            String?
  shiftName          String?
  totalWorkHours     Float?
  otHours            Float?    @default(0)
  lateHours          Float?    @default(0)
  earlyGoingHours    Float?    @default(0)
  presentDay         Float?    @default(1.0)
  isHalfDay          Boolean?  @default(false)
  isSundayPresent    Boolean?  @default(false)
  isFullNightPresent Boolean?  @default(false)
  isHolidayPresent   Boolean?  @default(false)
  captureMethod      String?   @default("BIOMETRIC")
}

model LeaveBalance {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  leaveType  String   // Casual, Sick, Earned
  allocated  Int
  used       Int      @default(0)
}

model LeaveApplication {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  leaveType  String
  startDate  DateTime
  endDate    DateTime
  reason     String
  status     String   @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
}

model LeaveLedger {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  leaveType  String
  change     Int      // positive for allocation, negative for usage
  reason     String
  createdAt  DateTime @default(now())
}

model Holiday {
  id       String   @id @default(uuid())
  name     String
  date     DateTime
}

model AppraisalCycle {
  id               String            @id @default(uuid())
  name             String            // e.g. FY26 Annual
  startDate        DateTime
  endDate          DateTime
  status           String            @default("ACTIVE") // ACTIVE, CLOSED
  goals            EmployeeGoal[]
  appraisalReviews AppraisalReview[]
}

model EmployeeGoal {
  id          String         @id @default(uuid())
  employeeId  String
  employee    Employee       @relation(fields: [employeeId], references: [id])
  cycleId     String
  cycle       AppraisalCycle @relation(fields: [cycleId], references: [id])
  title       String
  description String
  weightage   Int
  status      String         @default("PENDING") // PENDING, APPROVED, COMPLETED
}

model AppraisalReview {
  id              String         @id @default(uuid())
  employeeId      String
  employee        Employee       @relation(fields: [employeeId], references: [id])
  cycleId         String
  cycle           AppraisalCycle @relation(fields: [cycleId], references: [id])
  selfRating      Float?
  selfComments    String?
  managerRating   Float?
  managerComments String?
  finalRating     Float?
  status          String         @default("DRAFT") // DRAFT, SELF_REVIEW, MANAGER_REVIEW, COMPLETED
}

model TrainingRecord {
  id             String    @id @default(uuid())
  employeeId     String
  employee       Employee  @relation(fields: [employeeId], references: [id])
  trainingName   String    // e.g. Pharma GMP Compliance
  trainingType   String    // COMPLIANCE, TECHNICAL, SOFT_SKILLS
  completionDate DateTime
  expiryDate     DateTime?
  status         String    @default("COMPLETED") // COMPLETED, EXPIRED, PENDING
}

model ExitProcess {
  id                String                  @id @default(uuid())
  employeeId        String                  @unique
  employee          Employee                @relation(fields: [employeeId], references: [id])
  type              String                  // RESIGNATION, TERMINATION
  resignationDate   DateTime
  noticePeriodDays  Int
  lastWorkingDay    DateTime
  reason            String
  status            String                  @default("INITIATED") // INITIATED, CLEARANCE_IN_PROGRESS, SETTLED, COMPLETED
  clearances        ClearanceTask[]
  settlement        FullAndFinalSettlement?
}

model ClearanceTask {
  id              String      @id @default(uuid())
  exitProcessId   String
  exitProcess     ExitProcess @relation(fields: [exitProcessId], references: [id])
  department      String      // IT, Stores, Finance, Library, HR, Admin, Security
  taskDescription String
  status          String      @default("PENDING") // PENDING, CLEARED
  clearedAt       DateTime?
  clearedBy       String?
}

model FullAndFinalSettlement {
  id             String      @id @default(uuid())
  exitProcessId  String      @unique
  exitProcess    ExitProcess @relation(fields: [exitProcessId], references: [id])
  pendingSalary  Float
  leaveEncashment Float
  bonus          Float
  recoveries     Float
  netPayable     Float
  paymentStatus  String      @default("UNPAID") // UNPAID, PAID
  settlementDate DateTime?
}

enum GatePassType {
  INWARD
  OUTWARD
}

enum GatePassStatus {
  GATE_IN
  COMPLETED
  CANCELLED
}

model PassCategory {
  id          Int          @id @default(autoincrement())
  name        String
  code        String       @unique
  type        GatePassType
  description String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  gatePasses  GatePass[]
}

model GatePass {
  id                    Int            @id @default(autoincrement())
  passNumber            String         @unique
  type                  GatePassType
  categoryId            Int
  category              PassCategory   @relation(fields: [categoryId], references: [id])
  status                GatePassStatus @default(GATE_IN)

  // Vehicle & Driver Details
  imageUrl              String?
  vehicleNumber         String
  driverName            String
  driverContact         String?
  transporterName       String?

  // Inward specific fields
  supplierSource        String?
  deliveryChallanNumber String?
  declaredQuantity      String?
  poNumber              String?
  grnNumber             String?

  // Outward specific fields
  invoiceNumber         String?
  coaGenerated          Boolean        @default(false)
  purpose               String?        // e.g. Equipment repair, Sample dispatch, Sales

  // Automatic Timestamps
  timeIn                DateTime       @default(now())
  timeOut               DateTime?
  notes                 String?
 
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
}

model Bank {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  isActive  Boolean    @default(true)
  suppliers Supplier[]
  employees Employee[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Supplier {
  id                 Int      @id @default(autoincrement())
  code               String   @unique
  name               String
  address            String?
  gstNo              String
  contactPerson      String?
  phone              String?
  email              String?
  approvedCategories String[]
  approvalStatus     String   @default("Approved")
  
  bankId             Int?
  bank               Bank?    @relation(fields: [bankId], references: [id])
  accountNumber      String?
  ifscCode           String?
  accountName        String?
  
  rating             Float    @default(5.0)
  history            String?
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model DepartmentLeaveMaster {
  id            String   @id @default(uuid())
  department    String
  fiscalYear    String
  casualLeave   Int
  sickLeave     Int
  earnedLeave   Int
  otherLeave    Int      @default(0)
  totalLeave    Int
  effectiveFrom DateTime
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([department, fiscalYear])
}

model ActivityLog {
  id           String   @id @default(uuid())
  userId       String?  // The user ID who performed the action, null if guest/system
  userEmail    String?  // User email
  userName     String?  // User name
  userRole     String?  // User role
  action       String   // e.g. "CREATE_EMPLOYEE", "LOGIN", "DELETE_DEPARTMENT"
  entityType   String?  // e.g. "Employee", "LeaveApplication", "Department"
  entityId     String?  // ID of the target resource
  method       String   // GET, POST, PUT, PATCH, DELETE
  url          String   // request url path
  ip           String?  // IP address of the client
  userAgent    String?  // User agent
  statusCode   Int      // HTTP response status code
  requestBody  Json?    // Serialized request body (sanitized)
  queryParams  Json?    // Serialized query params
  routeParams  Json?    // Serialized route parameters
  responseBody Json?    // Serialized response body (sanitized, omitted if too large)
  createdAt    DateTime @default(now())
}

model SalaryStructure {
  id               String   @id @default(uuid())
  employeeId       String
  employee         Employee @relation(fields: [employeeId], references: [id])
  month            Int      @default(1)
  year             Int      @default(2026)
  basicSalary      Float
  hraAmount        Float    @default(0.0)
  da               Float    @default(0.0)  // Dearness Allowance
  conveyance       Float    @default(0.0)
  specialAllowance Float    @default(0.0)
  statutoryBonus   Float    @default(0.0)
  reimbursements   Float    @default(0.0)
  grossSalary      Float
  pfAmount         Float    @default(0.0)
  esiAmount        Float    @default(0.0)
  ptAmount         Float    @default(0.0)
  taxRegime        String   @default("NEW") // OLD, NEW
  effectiveFrom    DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([employeeId, month, year])
}

model HraRentReceipt {
  id                  String    @id @default(uuid())
  employeeId          String
  employee            Employee  @relation(fields: [employeeId], references: [id])
  financialYear       String    // e.g. 2026-2027
  landlordName        String
  landlordPan         String?
  landlordAddress     String
  monthlyRent         Float
  annualRent          Float
  rentReceiptUrl      String?
  status              String    @default("SUBMITTED") // SUBMITTED, APPROVED, REJECTED
  verifiedBy          String?
  verifiedAt          DateTime?
  calculatedExemption Float     @default(0.0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model TaxDeclaration {
  id                 String   @id @default(uuid())
  employeeId         String
  employee           Employee @relation(fields: [employeeId], references: [id])
  financialYear      String   // e.g. 2026-2027
  regime             String   @default("NEW") // OLD, NEW
  section80C         Float    @default(0.0)
  section80D         Float    @default(0.0)
  section80G         Float    @default(0.0)
  otherDeductions    Float    @default(0.0)
  hraExemptionAmount Float    @default(0.0)
  status             String   @default("SUBMITTED") // SUBMITTED, APPROVED, REJECTED
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model EmployeeLoan {
  id                 String   @id @default(uuid())
  employeeId         String
  employee           Employee @relation(fields: [employeeId], references: [id])
  loanType           String   @default("LOAN") // LOAN, SALARY_ADVANCE
  principalAmount    Float
  monthlyInstallment Float
  balanceRemaining   Float
  status             String   @default("ACTIVE") // ACTIVE, PAID_OFF, CANCELLED
  disbursedAt        DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model PayrollRun {
  id             String    @id @default(uuid())
  month          Int
  year           Int
  status         String    @default("DRAFT") // DRAFT, PREVIEW, APPROVED, PROCESSED
  totalEmployees Int       @default(0)
  totalGross     Float     @default(0.0)
  totalNet       Float     @default(0.0)
  approvedBy     String?
  approvedAt     DateTime?
  payslips       Payslip[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([month, year])
}

model Payslip {
  id               String      @id @default(uuid())
  payrollRunId     String
  payrollRun       PayrollRun  @relation(fields: [payrollRunId], references: [id])
  employeeId       String
  employee         Employee    @relation(fields: [employeeId], references: [id])
  month            Int
  year             Int
  totalDays        Int         @default(30)
  payableDays      Float       @default(30.0)
  lwpDays          Float       @default(0.0)
  otHours          Float       @default(0.0)
  
  // Earnings
  basicSalary      Float       @default(0.0)
  hra              Float       @default(0.0)
  da               Float       @default(0.0)
  conveyance       Float       @default(0.0)
  specialAllowance Float       @default(0.0)
  bonus            Float       @default(0.0)
  reimbursements   Float       @default(0.0)
  grossEarnings    Float       @default(0.0)
  
  // Deductions
  pfDeduction      Float       @default(0.0)
  esiDeduction     Float       @default(0.0)
  ptDeduction      Float       @default(0.0)
  tdsDeduction     Float       @default(0.0)
  loanRecovery     Float       @default(0.0)
  totalDeductions  Float       @default(0.0)
  
  netSalary        Float       @default(0.0)
  bankName         String?
  accountNumber    String?
  ifscCode         String?
  status           String      @default("GENERATED") // GENERATED, PAID
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model FiscalYear {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

