// ==========================================
// LOGISTICS MANAGEMENT ENUMS
// ==========================================

enum ShipmentType {
  INBOUND
  OUTBOUND
  WAREHOUSE_TRANSFER
  CUSTOMER_RETURN
  SUPPLIER_RETURN
}

enum ShipmentStatus {
  DRAFT
  PLANNED
  APPROVED
  PICKING
  PACKED
  READY_FOR_DISPATCH
  IN_TRANSIT
  ARRIVED
  RECEIVED
  DELIVERED
  ON_HOLD
  CLOSED
  CANCELLED
}

enum TransportMode {
  ROAD
  AIR
  RAIL
  SEA
  COURIER
}

enum VehicleStatus {
  AVAILABLE
  IN_TRANSIT
  MAINTENANCE
  DECOMMISSIONED
}

enum DriverStatus {
  ACTIVE
  ON_DUTY
  ON_LEAVE
  INACTIVE
}

enum RateType {
  PER_KG
  PER_KM
  PER_BOX
  PER_TRIP
  FLAT_RATE
}

enum ColdChainExcursionSeverity {
  LOW
  MEDIUM
  CRITICAL
}

enum ColdChainActionStatus {
  PENDING
  INVESTIGATING
  QA_HOLD
  RELEASED
  DESTROYED
}

enum TransferStatus {
  REQUESTED
  APPROVED
  REJECTED
  DISPATCHED
  IN_TRANSIT
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

enum ReturnType {
  CUSTOMER_RETURN
  SUPPLIER_RETURN
}

enum ReturnReason {
  DAMAGED_PRODUCT
  EXPIRED_PRODUCT
  INCORRECT_PRODUCT
  INCORRECT_QUANTITY
  QUALITY_COMPLAINT
  DELIVERY_REJECTION
  RECALL
  OTHER
}

enum ReturnDisposition {
  PENDING_INSPECTION
  APPROVED_FOR_RESTOCK
  RETURN_TO_SUPPLIER
  REJECTED
  DESTRUCTION
  FURTHER_INVESTIGATION
}

enum FreightPaymentStatus {
  PENDING
  VERIFIED
  APPROVED
  PAID
  DISPUTED
}

// ==========================================
// LOGISTICS MANAGEMENT MODELS
// ==========================================

model Transporter {
  id                 String           @id @default(uuid())
  transporterCode    String           @unique
  name               String
  gstin              String?
  transporterIdNo    String?          // Govt E-way bill Transporter ID
  contactPerson      String?
  phone              String?
  email              String?
  address            String?
  city               String?
  state              String?
  pincode            String?
  transportType      String?          @default("ROAD") // ROAD, MULTIMODAL, COURIER
  agreementStartDate DateTime?
  agreementEndDate   DateTime?
  rating             Float?           @default(5.0)
  isActive           Boolean          @default(true)
  remarks            String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  vehicles           LogisticsVehicle[]
  drivers            LogisticsDriver[]
  freightRates       FreightRate[]
  shipments          LogisticsShipment[]
  freightEntries     FreightEntry[]

  @@index([transporterCode])
  @@index([name])
}

model LogisticsVehicle {
  id                    String        @id @default(uuid())
  vehicleNumber         String        @unique
  vehicleType           String        // Container, Open Truck, Reefer Van, Pickup, Tempo
  transporterId         String?
  transporter           Transporter?  @relation(fields: [transporterId], references: [id], onDelete: SetNull)
  capacityWeightKg      Float         @default(1000)
  capacityVolumeCft     Float?        @default(100)
  isRefrigerated        Boolean       @default(false)
  minTempCelsius        Float?        // e.g. 2.0
  maxTempCelsius        Float?        // e.g. 8.0
  insuranceExpiryDate   DateTime?
  fitnessCertExpiryDate DateTime?
  permitDetails         String?
  gpsDeviceId           String?
  status                VehicleStatus @default(AVAILABLE)
  isActive              Boolean       @default(true)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  shipments             LogisticsShipment[]

  @@index([vehicleNumber])
  @@index([transporterId])
}

model LogisticsDriver {
  id             String       @id @default(uuid())
  driverCode     String       @unique
  name           String
  phone          String
  licenseNumber  String       @unique
  licenseExpiry  DateTime?
  transporterId  String?
  transporter    Transporter? @relation(fields: [transporterId], references: [id], onDelete: SetNull)
  emergencyPhone String?
  status         DriverStatus @default(ACTIVE)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  shipments      LogisticsShipment[]

  @@index([licenseNumber])
  @@index([transporterId])
}

model LogisticsRoute {
  id                 String        @id @default(uuid())
  routeCode          String        @unique
  origin             String        // Plant / Central Warehouse / City
  destination        String        // Distribution Center / Port / Client Hub
  distanceKm         Float         @default(0)
  estimatedTimeHours Float         @default(0)
  transportMode      TransportMode @default(ROAD)
  tollCharges        Float?        @default(0)
  isActive           Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  freightRates       FreightRate[]
  shipments          LogisticsShipment[]

  @@index([routeCode])
  @@index([origin, destination])
}

model FreightRate {
  id                String      @id @default(uuid())
  transporterId     String
  transporter       Transporter @relation(fields: [transporterId], references: [id], onDelete: Cascade)
  routeId           String?
  route             LogisticsRoute? @relation(fields: [routeId], references: [id], onDelete: SetNull)
  vehicleType       String?     // Reefer, 32ft Container, etc.
  rateType          RateType    @default(PER_KG)
  rate              Float       @default(0)
  minimumCharge     Float?      @default(0)
  additionalCharges Float?      @default(0)
  effectiveFrom     DateTime    @default(now())
  effectiveTo       DateTime?
  isActive          Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([transporterId])
  @@index([routeId])
}

model LogisticsShipment {
  id                     String           @id @default(uuid())
  shipmentNumber         String           @unique // e.g. SHP-2026-0001
  type                   ShipmentType     @default(OUTBOUND)
  status                 ShipmentStatus   @default(DRAFT)
  priority               String           @default("NORMAL") // NORMAL, URGENT, COLD_CHAIN
  
  // Linkages
  salesOrderId           String?
  purchaseOrderId        String?
  deliveryChallanId      String?
  invoiceId              String?
  gatePassId             String?
  
  // Parties
  senderName             String
  senderAddress          String?
  originWarehouse        String?
  receiverName           String
  receiverAddress        String?
  destinationWarehouse   String?
  
  // Transit details
  transporterId          String?
  transporter            Transporter?     @relation(fields: [transporterId], references: [id], onDelete: SetNull)
  vehicleId              String?
  vehicle                LogisticsVehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driverId               String?
  driver                 LogisticsDriver? @relation(fields: [driverId], references: [id], onDelete: SetNull)
  routeId                String?
  route                  LogisticsRoute?  @relation(fields: [routeId], references: [id], onDelete: SetNull)
  
  lrNumber               String?          // Lorry Receipt / Consignment Note #
  lrDate                 DateTime?
  ewayBillNumber         String?          // GST E-Way Bill Number
  ewayBillDate           DateTime?
  ewayBillValidUntil     DateTime?
  
  // Schedule
  plannedDispatchDate    DateTime?
  actualDispatchDate     DateTime?
  expectedDeliveryDate   DateTime?
  actualDeliveryDate     DateTime?
  
  // Cold chain profile
  isTemperatureSensitive Boolean          @default(false)
  requiredMinTemp        Float?
  requiredMaxTemp        Float?
  currentRecordedTemp    Float?
  temperatureLoggerId    String?
  hasTemperatureExcursion Boolean         @default(false)
  
  // Financials & Cargo metrics
  totalPackages          Int              @default(1)
  grossWeightKg          Float            @default(0)
  netWeightKg            Float            @default(0)
  estimatedFreight       Float?           @default(0)
  actualFreight          Float?           @default(0)
  
  // Proof of delivery
  podReceived            Boolean          @default(false)
  podReceivedDate        DateTime?
  podReceiverName        String?
  podRemarks             String?
  podDocumentUrl         String?
  
  remarks                String?
  dispatchedBy           String?
  approvedBy             String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  items                  LogisticsShipmentItem[]
  trackingEvents         LogisticsTrackingEvent[]
  temperatureLogs        LogisticsTemperatureLog[]
  temperatureExcursions  LogisticsTemperatureExcursion[]
  freightEntries         FreightEntry[]
  documents              LogisticsDocument[]

  @@index([shipmentNumber])
  @@index([type])
  @@index([status])
  @@index([transporterId])
  @@index([vehicleId])
}

model LogisticsShipmentItem {
  id              String            @id @default(uuid())
  shipmentId      String
  shipment        LogisticsShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  
  productId       String?
  productCode     String?
  productName     String
  batchNumber     String?
  manufacturingDate DateTime?
  expiryDate      DateTime?
  
  orderedQuantity Float             @default(1)
  shippedQuantity Float             @default(1)
  receivedQuantity Float?           @default(0)
  shortageQuantity Float?           @default(0)
  damagedQuantity Float?            @default(0)
  uom             String?           @default("NOS")
  
  cartonNumber    String?
  palletNumber    String?
  packageSealNo   String?
  unitPrice       Float?            @default(0)
  
  qaReleaseStatus String?           @default("RELEASED") // RELEASED, QUARANTINE, REJECTED
  remarks         String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([shipmentId])
  @@index([batchNumber])
}

model LogisticsTrackingEvent {
  id            String            @id @default(uuid())
  shipmentId    String
  shipment      LogisticsShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  
  status        ShipmentStatus
  locationName  String            // e.g. "Ahmedabad Hub", "En-route Mumbai-Pune Highway"
  timestamp     DateTime          @default(now())
  eventDetails  String?           // "Vehicle departed central warehouse gate #2"
  recordedBy    String?           // Operator / Driver / Automated GPS
  remarks       String?
  latitude      Float?
  longitude     Float?
  
  createdAt     DateTime          @default(now())

  @@index([shipmentId])
  @@index([timestamp])
}

model LogisticsTemperatureLog {
  id             String            @id @default(uuid())
  shipmentId     String
  shipment       LogisticsShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  
  loggerId       String?
  temperature    Float             // e.g. 4.2°C
  humidity       Float?            // e.g. 55% RH
  readingTime    DateTime          @default(now())
  isExcursion    Boolean           @default(false)
  locationStamp  String?
  
  createdAt      DateTime          @default(now())

  @@index([shipmentId])
  @@index([readingTime])
}

model LogisticsTemperatureExcursion {
  id                  String                     @id @default(uuid())
  shipmentId          String
  shipment            LogisticsShipment          @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  
  excursionNumber     String                     @unique // e.g. EXC-2026-0001
  severity            ColdChainExcursionSeverity @default(MEDIUM)
  minRecordedTemp     Float
  maxRecordedTemp     Float
  allowableMinTemp    Float
  allowableMaxTemp    Float
  durationMinutes     Int                        @default(0)
  timeDetected        DateTime                   @default(now())
  investigationStatus ColdChainActionStatus      @default(PENDING)
  
  qaReviewRemarks     String?
  correctiveAction    String?
  dispositionAction   String?                    // RELEASED_UNDER_CONCESSION, DESTROY, RETURN_TO_QUARANTINE
  qaOfficerName       String?
  qaSignoffDate       DateTime?
  
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  @@index([shipmentId])
  @@index([excursionNumber])
}

model WarehouseTransferRequest {
  id                    String         @id @default(uuid())
  transferNumber        String         @unique // e.g. TR-2026-0001
  sourceWarehouse       String
  destinationWarehouse  String
  requiredDate          DateTime?
  status                TransferStatus @default(REQUESTED)
  reason                String?
  requestedBy           String
  approvedBy            String?
  dispatchedDate        DateTime?
  receivedDate          DateTime?
  shipmentNumberRef     String?
  notes                 String?
  
  items                 Json           // Array of { productCode, productName, batchNumber, requestedQty, dispatchedQty, receivedQty, uom }
  
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([transferNumber])
  @@index([status])
}

model LogisticsReturn {
  id                    String            @id @default(uuid())
  returnNumber          String            @unique // e.g. RET-2026-0001
  returnType            ReturnType        @default(CUSTOMER_RETURN)
  partyName             String            // Customer or Supplier Name
  originalInvoiceNo     String?
  originalShipmentNo    String?
  reason                ReturnReason      @default(DAMAGED_PRODUCT)
  disposition           ReturnDisposition @default(PENDING_INSPECTION)
  status                String            @default("REQUESTED") // REQUESTED, RECEIVED, INSPECTED, ADJUSTED, CLOSED
  returnDate            DateTime          @default(now())
  
  totalReturnedQty      Float             @default(0)
  quarantinedLocation   String?           @default("Quarantine Bay Q-01")
  
  qaInspectionRemarks   String?
  qaInspector           String?
  qaInspectionDate      DateTime?
  
  creditDebitNoteNumber String?
  items                 Json              // Array of { productCode, productName, batchNumber, returnedQty, acceptedRestockQty, rejectedQty, reason }
  
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([returnNumber])
  @@index([returnType])
}

model FreightEntry {
  id                  String               @id @default(uuid())
  invoiceNumber       String               @unique // Transporter invoice #
  shipmentId          String?
  shipment            LogisticsShipment?   @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  transporterId       String
  transporter         Transporter          @relation(fields: [transporterId], references: [id], onDelete: Cascade)
  
  invoiceDate         DateTime             @default(now())
  baseFreightAmount   Float                @default(0)
  loadingCharges      Float?               @default(0)
  unloadingCharges    Float?               @default(0)
  fuelSurcharge       Float?               @default(0)
  detentionCharges    Float?               @default(0)
  tollCharges         Float?               @default(0)
  otherCharges        Float?               @default(0)
  taxAmount           Float?               @default(0)
  totalAmount         Float                @default(0)
  
  paymentStatus       FreightPaymentStatus @default(PENDING)
  approvedBy          String?
  remarks             String?
  
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([invoiceNumber])
  @@index([transporterId])
  @@index([shipmentId])
}

model LogisticsDocument {
  id             String            @id @default(uuid())
  documentNumber String            @unique
  documentType   String            // DELIVERY_CHALLAN, LORRY_RECEIPT, EWAY_BILL, PACKING_LIST, TEMPERATURE_REPORT, POD
  shipmentId     String?
  shipment       LogisticsShipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  title          String
  fileUrl        String?
  version        String            @default("v1.0")
  uploadedBy     String?
  createdAt      DateTime          @default(now())

  @@index([documentNumber])
  @@index([shipmentId])
}
