model DeliveryChallanItem {
  id              String           @id @default(uuid())
  challanId       String
  challan         DeliveryChallan  @relation(fields: [challanId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  uomId           String?
  uomRelation     Uom?             @relation(fields: [uomId], references: [id], onDelete: SetNull)
  itemCode        String?
  itemName        String
  description     String?
  hsnCode         String?
  uom             String?
  batchNumber     String?
  quantity        Float            @default(1)
  unitPrice       Float            @default(0.0)
  discountPercent Float            @default(0.0)
  taxPercent      Float            @default(0.0)
  cgstAmount      Float            @default(0.0)
  sgstAmount      Float            @default(0.0)
  igstAmount      Float            @default(0.0)
  totalPrice      Float            @default(0.0)
  sortOrder       Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([challanId])
  @@index([productId])
  @@index([uomId])
}

// ==========================================
// 11. MAIN STORE (MAINTENANCE & ENGINEERING)
// ==========================================

model MaintenanceItem {
  id                  String                  @id @default(uuid())
  partNumber          String                  @unique // e.g. "SPR-BRG-6205", "TOOL-TRQ-WRENCH-01"
  name                String                  // e.g. "Deep Groove Ball Bearing 6205-2RS"
  description         String?                 // Technical specifications / make / model
  category            MaintenanceItemCategory @default(SPARE_PARTS)
  equipmentLinkage    String?                 // Linked Machine/Equipment, e.g. "Blister Packing Machine - B-01", "Tablet Compression - TC-03"
  uomId               String?
  uomRelation         Uom?                    @relation(fields: [uomId], references: [id], onDelete: SetNull)
  uom                 String                  @default("NOS") // NOS, SET, MTR, LTR, KG, PKT
  storageBinRack      String?                 // Shelf / Rack / Bin, e.g. "M-RACK-02-B3"
  
  // Stock Control
  currentStock        Float                   @default(0.0)
  minimumStock        Float                   @default(0.0) // Low stock alert threshold
  maximumStock        Float?                  @default(0.0)
  reorderQuantity     Float?                  @default(0.0)
  unitCost            Float                   @default(0.0)
  
  // PM Linkage & Procurement flags
  isPreventiveLinked  Boolean                 @default(false)
  pmScheduleReference String?                 // e.g. "PM-SCH-MONTHLY-BLISTER"
  preferredSupplier   String?                 // Supplier name or code
  
  isActive            Boolean                 @default(true)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  requisitionItems    MaintenanceRequisitionItem[]
  issueItems          MaintenanceIssueItem[]

  @@index([category])
  @@index([equipmentLinkage])
  @@index([uomId])
}

model MaintenanceRequisition {
  id                  String                         @id @default(uuid())
  requisitionNumber   String                         @unique // e.g. "MR-2026-0001"
  requisitionDate     DateTime                       @default(now())
  department          String                         @default("Maintenance")
  requesterName       String                         // Requester staff name
  requesterEmployeeId String?
  requesterEmployee   Employee?                      @relation("MaintenanceRequesterEmployee", fields: [requesterEmployeeId], references: [id], onDelete: SetNull)
  
  assignedToName       String?                        // Technician / Engineer assigned
  assignedToEmployeeId String?                        // Employee ID assigned
  assignedToEmployee   Employee?                      @relation("MaintenanceAssigneeEmployee", fields: [assignedToEmployeeId], references: [id], onDelete: SetNull)
  
  purpose             String                         // Purpose / Machine breakdown or preventive work order reference
  equipmentMachine    String?                        // Target Equipment / Line
  workOrderNumber     String?                        // Maintenance Work Order / Job Card #
  priority            MaintenanceRequisitionPriority @default(MEDIUM)
  status              MaintenanceRequisitionStatus   @default(DRAFT)
  
  pmScheduleId        String?                        // Optional PM schedule reference
  remarks             String?
  
  approvedBy          String?
  approvedAt          DateTime?
  rejectionReason     String?
  
  createdAt           DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt

  items               MaintenanceRequisitionItem[]
  issues              MaintenanceIssue[]

  @@index([status])
  @@index([equipmentMachine])
  @@index([requesterEmployeeId])
  @@index([assignedToEmployeeId])
}

model MaintenanceRequisitionItem {
  id                  String                 @id @default(uuid())
  requisitionId       String
  requisition         MaintenanceRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  
  itemId              String
  item                MaintenanceItem        @relation(fields: [itemId], references: [id])
  
  requestedQuantity   Float                  @default(1.0)
  issuedQuantity      Float                  @default(0.0)
  unitCost            Float                  @default(0.0)
  remarks             String?
  
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([requisitionId])
  @@index([itemId])
}

model MaintenanceIssue {
  id                  String                 @id @default(uuid())
  issueNumber         String                 @unique // e.g. "MI-2026-0001"
  issueDate           DateTime               @default(now())
  
  requisitionId       String
  requisition         MaintenanceRequisition @relation(fields: [requisitionId], references: [id])
  
  issuedBy            String                 // Store keeper / issuer name
  receivedBy          String                 // Engineer / technician recipient
  purpose             String                 // Recorded purpose
  equipmentMachine    String?                // Machine on which part is installed
  
  status              MaintenanceIssueStatus @default(COMPLETED)
  remarks             String?
  
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  items               MaintenanceIssueItem[]

  @@index([requisitionId])
}

model MaintenanceIssueItem {
  id                  String           @id @default(uuid())
  issueId             String
  issue               MaintenanceIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  
  itemId              String
  item                MaintenanceItem  @relation(fields: [itemId], references: [id])
  
  quantityIssued      Float            @default(1.0)
  unitCost            Float            @default(0.0)
  totalCost           Float            @default(0.0)
  remarks             String?
  
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([issueId])
  @@index([itemId])
}

model StoreCategory {
  id            String    @id @default(uuid())
  categoryCode  String    @unique
  categoryName  String
  description   String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([categoryCode])
}
