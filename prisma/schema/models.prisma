model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  password     String
  role         String        @default("USER") // ADMIN, HR, EMPLOYEE
  createdAt    DateTime      @default(now())
  employee     Employee?
  activityLogs ActivityLog[]
  interviewFeedbacks InterviewFeedback[]
}

model Employee {
  id               String               @id @default(uuid())
  employeeId       String               @unique // e.g. ASP-2026-0001
  userId           String?              @unique
  user             User?                @relation(fields: [userId], references: [id])
  firstName        String
  lastName         String
  email            String               @unique
  departmentId     String
  department       Department           @relation(fields: [departmentId], references: [id])
  designation      String
  managerId        String?
  manager          Employee?            @relation("EmployeeManager", fields: [managerId], references: [id])
  subordinates     Employee[]           @relation("EmployeeManager")
  dateOfJoining    DateTime
  probationEnd     DateTime?
  probationStatus  ProbationStatus      @default(UNDER_REVIEW)
  totalExperienceYears Float?           @default(0.0)
  status           EmployeeStatus       @default(ACTIVE)
  
  // QR Code & Public Profile Details
  phone            String?
  location         String?
  qrToken          String               @unique @default(uuid())

  // Bank & Statutory Details
  bankId           Int?
  bank             Bank?                @relation(fields: [bankId], references: [id])
  bankName         String?
  accountNumber    String?
  ifscCode         String?
  panNumber        String?

  createdAt        DateTime             @default(now())
  documents        OnboardingDocument[]
  induction        InductionSchedule?
  systemAccess     SystemAccess?
  roster           ShiftRoster[]
  attendance       Attendance[]
  leaveBalances    LeaveBalance[]
  leaveApplications LeaveApplication[]
  leaveLedger      LeaveLedger[]
  goals            EmployeeGoal[]
  appraisalReviews AppraisalReview[]
  trainings        TrainingRecord[]
  exitProcess      ExitProcess?
  salaryStructures  SalaryStructure[]
  rentReceipts     HraRentReceipt[]
  taxDeclarations  TaxDeclaration[]
  loans            EmployeeLoan[]
  payslips         Payslip[]
  replacedRequisitions JobRequisition[] @relation("RequisitionReplacementEmployee")
  breakIncidents   BreakMisuseIncident[]
  shiftAuditLogs   ShiftAuditLog[]
}

model Department {
  id             String                  @id @default(uuid())
  name           String                  @unique
  isActive       Boolean                 @default(true)
  createdAt      DateTime                @default(now())
  requisitions   JobRequisition[]
  employees      Employee[]
  clearanceTasks ClearanceTask[]
  leaveMasters   DepartmentLeaveMaster[]
  shiftRosters   ShiftRoster[]
}

model TrainingType {
  id              String           @id @default(uuid())
  name            String           @unique
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  trainingRecords TrainingRecord[]
}

model JobRequisition {
  id                       String               @id @default(uuid())
  title                    String
  departmentId             String
  department               Department           @relation(fields: [departmentId], references: [id])
  headcount                Int
  justification            String
  jobSpecification         String?
  experienceRequired       Float?               @default(0.0)
  requisitionType          RequisitionType      @default(NEW_REQUIREMENT)
  replacementForEmployeeId String?
  replacementForEmployee   Employee?            @relation("RequisitionReplacementEmployee", fields: [replacementForEmployeeId], references: [id])
  status                   JobRequisitionStatus @default(PENDING)
  raisedBy                 String
  isCnvApplicable          Boolean              @default(false)
  cnvNotificationDate      DateTime?
  cnvExchangeOffice        String?
  cnvRefNumber             String?
  cnvStatus                String?              @default("NOT_REQUIRED")
  cnvExemptionReason       String?
  createdAt                DateTime             @default(now())
  candidates               Candidate[]
}

model Candidate {
  id              String              @id @default(uuid())
  name            String
  email           String              @unique
  phone           String?
  resumeUrl       String?
  source          String              // Referral, Portal, Agency, LinkedIn, Walk-in, Website
  experienceYears Float?              @default(0.0)
  status          CandidateStatus     @default(SOURCED)
  isReInterview   Boolean             @default(false)
  rejectionCount  Int                 @default(0)
  rejectedAt      DateTime?
  coolOffDaysLeft Int?                @default(0)
  requisitionId   String
  requisition     JobRequisition      @relation(fields: [requisitionId], references: [id])
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @default(now()) @updatedAt
  schedules       InterviewSchedule[]
  offer           OfferLetter?
}

model InterviewSchedule {
  id            String              @id @default(uuid())
  candidateId   String
  candidate     Candidate           @relation(fields: [candidateId], references: [id])
  roundName     String              // e.g. Technical, HR, Manager
  scheduledAt   DateTime
  panelists     String[]              // Array or comma-separated panelist IDs
  status        InterviewStatus     @default(SCHEDULED)
  isReschedule  Boolean             @default(false)
  attemptNumber Int                 @default(1)
  feedbacks     InterviewFeedback[]
}

model InterviewFeedback {
  id             String            @id @default(uuid())
  scheduleId     String
  schedule       InterviewSchedule @relation(fields: [scheduleId], references: [id])
  panelistName   String
  panelistId     String?
  panelist       User?             @relation(fields: [panelistId], references: [id])
  rating         Int
  comments       String
  recommendation Recommendation
  createdAt      DateTime          @default(now())
}

model OfferLetter {
  id          String    @id @default(uuid())
  candidateId String    @unique
  candidate   Candidate @relation(fields: [candidateId], references: [id])
  role        String
  salary      Float
  joiningDate DateTime
  status      OfferStatus @default(GENERATED)
  createdAt   DateTime    @default(now())
}

model OnboardingDocument {
  id           String   @id @default(uuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id])
  documentType String   // Aadhaar, PAN, Passport, Address Proof, Education Certificates, Previous Employment, Bank Details, Photo
  status       DocumentStatus @default(PENDING)
  fileUrl      String?
  verifiedAt   DateTime?
}

model InductionSchedule {
  id          String   @id @default(uuid())
  employeeId  String   @unique
  employee    Employee @relation(fields: [employeeId], references: [id])
  scheduledAt DateTime
  trainer     String
  status      InductionStatus @default(SCHEDULED)
}

model SystemAccess {
  id             String   @id @default(uuid())
  employeeId     String   @unique
  employee       Employee @relation(fields: [employeeId], references: [id])
  erpLogin       Boolean  @default(false)
  email          Boolean  @default(false)
  attendanceApp  Boolean  @default(false)
  vpn            Boolean  @default(false)
}

model Shift {
  id                   String        @id @default(uuid())
  name                 String        // Morning, Evening, Night, Flexible
  startTime            String        // HH:MM
  endTime              String
  graceTimeMinutes     Int?          @default(15)
  breakDurationMinutes Int?          @default(60)
  breakRules           String?       // e.g. 45 min Lunch + 15 min Tea Break
  isNightShift         Boolean       @default(false)
  color                String?       @default("#0284c7")
  description          String?
  rosters              ShiftRoster[]
  attendances          Attendance[]
}

model ShiftRoster {
  id           String          @id @default(uuid())
  employeeId   String
  employee     Employee        @relation(fields: [employeeId], references: [id])
  shiftId      String
  shift        Shift           @relation(fields: [shiftId], references: [id])
  departmentId String?
  department   Department?     @relation(fields: [departmentId], references: [id])
  managedByHod String?
  date         DateTime
  reason       String?
  auditLogs    ShiftAuditLog[]
}

model ShiftAuditLog {
  id            String       @id @default(uuid())
  rosterId      String?
  roster        ShiftRoster? @relation(fields: [rosterId], references: [id], onDelete: SetNull)
  employeeId    String
  employee      Employee     @relation(fields: [employeeId], references: [id])
  oldShiftId    String?
  oldShiftName  String?
  newShiftId    String
  newShiftName  String
  rosterDate    DateTime
  changedById   String?
  changedByName String
  changedByRole String       @default("HOD")
  reason        String?
  createdAt     DateTime     @default(now())
}

model Attendance {
  id                  String                @id @default(uuid())
  employeeId          String
  employee            Employee              @relation(fields: [employeeId], references: [id])
  date                DateTime
  checkIn             DateTime?
  checkOut            DateTime?
  status              AttendanceStatus      @default(PRESENT)
  shiftId             String?
  shift               Shift?                @relation(fields: [shiftId], references: [id])
  shiftName           String?
  totalWorkHours      Float?
  otHours             Float?                @default(0)
  lateHours           Float?                @default(0)
  earlyGoingHours     Float?                @default(0)
  presentDay          Float?                @default(1.0)
  isHalfDay           Boolean?              @default(false)
  isSundayPresent     Boolean?              @default(false)
  isFullNightPresent  Boolean?              @default(false)
  isHolidayPresent    Boolean?              @default(false)
  captureMethod       String?               @default("BIOMETRIC")
  breakMisuseMinutes  Int?                  @default(0)
  breakDeductionHours Float?                @default(0.0)
  hasBreakComplaint   Boolean?              @default(false)
  breakIncidents      BreakMisuseIncident[]
}

model BreakMisuseIncident {
  id               String       @id @default(uuid())
  attendanceId     String?
  attendance       Attendance?  @relation(fields: [attendanceId], references: [id])
  employeeId       String
  employee         Employee     @relation(fields: [employeeId], references: [id])
  reportedByHodId  String?
  reportedByName   String
  incidentDate     DateTime
  breakType        String       // LUNCH_BREAK, TEA_BREAK, GENERAL_BREAK, SMOKING_BREAK
  excessMinutes    Int          @default(0)
  deductionHours   Float        @default(0.0)
  severity         String       @default("WARNING") // WARNING, HALF_DAY_DEDUCTION, SALARY_DEDUCTION, VERBAL_ALERT
  complaintDetails String
  status           String       @default("REPORTED") // REPORTED, APPROVED, WAIVED
  createdAt        DateTime     @default(now())
}

model LeaveBalance {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  leaveType  String   // Casual, Sick, Earned
  allocated  Int
  used       Int      @default(0)
}

model LeaveApplication {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  leaveType  String
  startDate  DateTime
  endDate    DateTime
  reason     String
  status     LeaveStatus @default(PENDING)
}

model LeaveLedger {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  leaveType  String
  change     Int      // positive for allocation, negative for usage
  reason     String
  createdAt  DateTime @default(now())
}

model Holiday {
  id       String   @id @default(uuid())
  name     String
  date     DateTime
}

model AppraisalCycle {
  id               String            @id @default(uuid())
  name             String            // e.g. FY26 Annual
  startDate        DateTime
  endDate          DateTime
  status           AppraisalCycleStatus @default(ACTIVE)
  goals            EmployeeGoal[]
  appraisalReviews AppraisalReview[]
}

model EmployeeGoal {
  id          String         @id @default(uuid())
  employeeId  String
  employee    Employee       @relation(fields: [employeeId], references: [id])
  cycleId     String
  cycle       AppraisalCycle @relation(fields: [cycleId], references: [id])
  title       String
  description String
  weightage   Int
  status      GoalStatus @default(PENDING)
}

model AppraisalReview {
  id              String         @id @default(uuid())
  employeeId      String
  employee        Employee       @relation(fields: [employeeId], references: [id])
  cycleId         String
  cycle           AppraisalCycle @relation(fields: [cycleId], references: [id])
  selfRating      Float?
  selfComments    String?
  managerRating   Float?
  managerComments String?
  finalRating     Float?
  status          AppraisalReviewStatus @default(DRAFT)
}

model TrainingRecord {
  id             String       @id @default(uuid())
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id])
  trainingName   String       // e.g. Pharma GMP Compliance
  trainingTypeId String
  trainingType   TrainingType @relation(fields: [trainingTypeId], references: [id])
  completionDate DateTime
  expiryDate     DateTime?
  status         TrainingStatus @default(COMPLETED)
}

model ExitProcess {
  id                String                  @id @default(uuid())
  employeeId        String                  @unique
  employee          Employee                @relation(fields: [employeeId], references: [id])
  type              ExitType
  resignationDate   DateTime
  noticePeriodDays  Int
  lastWorkingDay    DateTime
  reason            String
  status            ExitStatus              @default(INITIATED)
  clearances        ClearanceTask[]
  settlement        FullAndFinalSettlement?
}

model ClearanceTask {
  id              String      @id @default(uuid())
  exitProcessId   String
  exitProcess     ExitProcess @relation(fields: [exitProcessId], references: [id])
  departmentId    String
  department      Department  @relation(fields: [departmentId], references: [id])
  taskDescription String
  status          ClearanceStatus @default(PENDING)
  clearedAt       DateTime?
  clearedBy       String?
}

model FullAndFinalSettlement {
  id             String      @id @default(uuid())
  exitProcessId  String      @unique
  exitProcess    ExitProcess @relation(fields: [exitProcessId], references: [id])
  pendingSalary  Float
  leaveEncashment Float
  bonus          Float
  recoveries     Float
  netPayable     Float
  paymentStatus  PaymentStatus @default(UNPAID)
  settlementDate DateTime?
}

model PassCategory {
  id          Int          @id @default(autoincrement())
  name        String
  code        String       @unique
  type        GatePassType
  description String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  gatePasses  GatePass[]
}

model GatePass {
  id                    Int            @id @default(autoincrement())
  passNumber            String         @unique
  type                  GatePassType
  categoryId            Int
  category              PassCategory   @relation(fields: [categoryId], references: [id])
  status                GatePassStatus @default(GATE_IN)

  // Vehicle & Driver Details
  imageUrl              String?
  vehicleNumber         String
  driverName            String
  driverContact         String?
  transporterName       String?

  // Inward specific fields
  supplierSource        String?
  deliveryChallanNumber String?
  declaredQuantity      String?
  poNumber              String?
  grnNumber             String?

  // Outward specific fields
  invoiceNumber         String?
  coaGenerated          Boolean        @default(false)
  purpose               String?        // e.g. Equipment repair, Sample dispatch, Sales

  // Automatic Timestamps
  timeIn                DateTime       @default(now())
  timeOut               DateTime?
  notes                 String?
 
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
}

model Bank {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  isActive  Boolean    @default(true)
  suppliers Supplier[]
  employees Employee[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Supplier {
  id                 Int      @id @default(autoincrement())
  code               String   @unique
  name               String
  address            String?
  gstNo              String
  contactPerson      String?
  phone              String?
  email              String?
  approvedCategories String[]
  approvalStatus     String   @default("Approved")
  
  bankId             Int?
  bank               Bank?    @relation(fields: [bankId], references: [id])
  accountNumber      String?
  ifscCode           String?
  accountName        String?
  
  rating             Float    @default(5.0)
  history            String?
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model DepartmentLeaveMaster {
  id            String     @id @default(uuid())
  departmentId  String
  department    Department @relation(fields: [departmentId], references: [id])
  fiscalYearId  String
  fiscalYear    FiscalYear @relation(fields: [fiscalYearId], references: [id])
  casualLeave   Int
  sickLeave     Int
  earnedLeave   Int
  otherLeave    Int        @default(0)
  totalLeave    Int
  effectiveFrom DateTime
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([departmentId, fiscalYearId])
}

model ActivityLog {
  id           String   @id @default(uuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  userEmail    String?  // User email
  userName     String?  // User name
  userRole     String?  // User role
  action       String   // e.g. "CREATE_EMPLOYEE", "LOGIN", "DELETE_DEPARTMENT"
  entityType   String?  // e.g. "Employee", "LeaveApplication", "Department"
  entityId     String?  // ID of the target resource
  method       String   // GET, POST, PUT, PATCH, DELETE
  url          String   // request url path
  ip           String?  // IP address of the client
  userAgent    String?  // User agent
  statusCode   Int      // HTTP response status code
  requestBody  Json?    // Serialized request body (sanitized)
  queryParams  Json?    // Serialized query params
  routeParams  Json?    // Serialized route parameters
  responseBody Json?    // Serialized response body (sanitized, omitted if too large)
  createdAt    DateTime @default(now())
}

model SalaryStructure {
  id               String   @id @default(uuid())
  employeeId       String
  employee         Employee @relation(fields: [employeeId], references: [id])
  month            Int      @default(1)
  year             Int      @default(2026)
  basicSalary      Float
  hraAmount        Float    @default(0.0)
  da               Float    @default(0.0)  // Dearness Allowance
  conveyance       Float    @default(0.0)
  specialAllowance Float    @default(0.0)
  statutoryBonus   Float    @default(0.0)
  reimbursements   Float    @default(0.0)
  grossSalary      Float
  pfAmount         Float    @default(0.0)
  esiAmount        Float    @default(0.0)
  ptAmount         Float    @default(0.0)
  taxRegime        TaxRegime @default(NEW)
  effectiveFrom    DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([employeeId, month, year])
}

model HraRentReceipt {
  id                  String     @id @default(uuid())
  employeeId          String
  employee            Employee   @relation(fields: [employeeId], references: [id])
  financialYearId     String
  financialYear       FiscalYear @relation(fields: [financialYearId], references: [id])
  landlordName        String
  landlordPan         String?
  landlordAddress     String
  monthlyRent         Float
  annualRent          Float
  rentReceiptUrl      String?
  status              RentReceiptStatus @default(SUBMITTED)
  verifiedBy          String?
  verifiedAt          DateTime?
  calculatedExemption Float      @default(0.0)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
}

model TaxDeclaration {
  id                 String     @id @default(uuid())
  employeeId         String
  employee           Employee   @relation(fields: [employeeId], references: [id])
  financialYearId    String
  financialYear      FiscalYear @relation(fields: [financialYearId], references: [id])
  regime             TaxRegime  @default(NEW)
  section80C         Float      @default(0.0)
  section80D         Float      @default(0.0)
  section80G         Float      @default(0.0)
  otherDeductions    Float      @default(0.0)
  hraExemptionAmount Float      @default(0.0)
  status             TaxDeclarationStatus @default(SUBMITTED)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
}

model EmployeeLoan {
  id                 String   @id @default(uuid())
  employeeId         String
  employee           Employee @relation(fields: [employeeId], references: [id])
  loanType           String   @default("LOAN") // LOAN, SALARY_ADVANCE
  principalAmount    Float
  monthlyInstallment Float
  balanceRemaining   Float
  status             LoanStatus @default(ACTIVE)
  disbursedAt        DateTime   @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model PayrollRun {
  id             String    @id @default(uuid())
  month          Int
  year           Int
  status         PayrollStatus @default(DRAFT)
  totalEmployees Int           @default(0)
  totalGross     Float     @default(0.0)
  totalNet       Float     @default(0.0)
  approvedBy     String?
  approvedAt     DateTime?
  payslips       Payslip[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([month, year])
}

model Payslip {
  id               String      @id @default(uuid())
  payrollRunId     String
  payrollRun       PayrollRun  @relation(fields: [payrollRunId], references: [id])
  employeeId       String
  employee         Employee    @relation(fields: [employeeId], references: [id])
  month            Int
  year             Int
  totalDays        Int         @default(30)
  payableDays      Float       @default(30.0)
  lwpDays          Float       @default(0.0)
  otHours          Float       @default(0.0)
  
  // Earnings
  basicSalary      Float       @default(0.0)
  hra              Float       @default(0.0)
  da               Float       @default(0.0)
  conveyance       Float       @default(0.0)
  specialAllowance Float       @default(0.0)
  bonus            Float       @default(0.0)
  reimbursements   Float       @default(0.0)
  grossEarnings    Float       @default(0.0)
  
  // Deductions
  pfDeduction      Float       @default(0.0)
  esiDeduction     Float       @default(0.0)
  ptDeduction      Float       @default(0.0)
  tdsDeduction     Float       @default(0.0)
  loanRecovery     Float       @default(0.0)
  totalDeductions  Float       @default(0.0)
  
  netSalary        Float       @default(0.0)
  bankName         String?
  accountNumber    String?
  ifscCode         String?
  status           PayslipStatus @default(GENERATED)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime    @updatedAt
}

model FiscalYear {
  id              String                  @id @default(uuid())
  name            String                  @unique
  isActive        Boolean                 @default(true)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  leaveMasters    DepartmentLeaveMaster[]
  taxDeclarations TaxDeclaration[]
  rentReceipts    HraRentReceipt[]
}
